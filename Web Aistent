                <div className="flex gap-2">
                  <button 
                    onClick={() => { setTimerSeconds(180); setIsTimerRunning(false); }}
                    className="px-3 py-1 bg-emerald-700 hover:bg-emerald-600 text-xs font-semibold rounded-lg"
                  >
                    3 Menit (Ice Break)
                  </button>
                  <button 
                    onClick={() => { setTimerSeconds(300); setIsTimerRunning(false); }}
                    className="px-3 py-1 bg-emerald-700 hover:bg-emerald-600 text-xs font-semibold rounded-lg"
                  >
                    5 Menit (Kuis Singkat)
                  </button>
                  <button 
                    onClick={() => { setTimerSeconds(900); setIsTimerRunning(false); }}
                    className="px-3 py-1 bg-emerald-700 hover:bg-emerald-600 text-xs font-semibold rounded-lg"
                  >
                    15 Menit (Diskusi Kelompok)
                  </button>
                </div>

                {/* Control Buttons */}
                <div className="flex items-center gap-3 pt-2">
                  <button
                    onClick={() => setIsTimerRunning(!isTimerRunning)}
                    className="px-6 py-2.5 bg-amber-400 hover:bg-amber-300 text-emerald-950 font-bold rounded-xl shadow-md flex items-center gap-2 transition-all text-sm"
                  >
                    {isTimerRunning ? <Pause className="w-4 h-4" /> : <Play className="w-4 h-4" />}
                    {isTimerRunning ? 'Jeda Timer' : 'Mulai Timer'}
                  </button>
                  <button
                    onClick={() => { setIsTimerRunning(false); setTimerSeconds(300); }}
                    className="p-2.5 bg-emerald-700 hover:bg-emerald-600 text-white rounded-xl transition-all"
                  >
                    <RotateCcw className="w-4 h-4" />
                  </button>
                </div>
              </div>

              {/* BANK ICE BREAKING */}
              <div className="space-y-4">
                <div className="flex items-center gap-2">
                  <Smile className="w-5 h-5 text-amber-500" />
                  <h3 className="font-bold text-slate-800 text-lg">Kumpulan Ice Breaking Seru untuk Anak SD Kelas 2</h3>
                </div>

                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                  {ICE_BREAKERS.map((item, index) => (
                    <div key={index} className="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-3 hover:border-emerald-300 transition-all">
                      <div className="flex justify-between items-start">
                        <span className="font-bold text-slate-800 text-base">{item.title}</span>
                        <span className="text-[10px] font-bold px-2 py-0.5 bg-amber-100 text-amber-800 rounded-md">
                          {item.duration}
                        </span>
                      </div>
                      
                      <p className="text-xs text-slate-600 leading-relaxed">
                        {item.description}
                      </p>

                      <div className="pt-2 border-t border-slate-100 flex items-center justify-between text-[11px]">
                        <span className="text-emerald-700 font-semibold">Tujuan: {item.purpose}</span>
                        <span className="text-slate-400 font-medium">{item.category}</span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

            </div>
          )}

        </div>
      </main>
    </div>
  );
}
